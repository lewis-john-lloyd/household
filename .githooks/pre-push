#!/bin/sh
# Checks what is being pushed for household data, then runs the import guard and the tests.
# Turn on once per clone:  git config core.hooksPath .githooks
# Uses .venv/bin/python when there is one, else $PYTHON, else python3.
if [ -x .venv/bin/python ]; then py=.venv/bin/python; else py=${PYTHON:-python3}; fi
exec "$py" tools/push_guard.py
