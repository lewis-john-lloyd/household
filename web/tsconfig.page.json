{
  "compilerOptions": {
    "target": "ES2019",
    "lib": [
      "ES2019",
      "ES2020.Intl",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "none",
    "types": [
      "google-apps-script"
    ],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "build/page",
    "exactOptionalPropertyTypes": true,
    "alwaysStrict": false,
    "skipLibCheck": true
  },
  "include": [
    "src/*.ts",
    "src/page/**/*.ts"
  ]
}
